# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Discord bot (notifications + human approval)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Discord role ID allowed to approve/reject remediation actions via the
# bot's buttons/modal (Server Settings -> Roles -> copy ID with Developer
# Mode enabled).
DISCORD_APPROVER_ROLE_ID=
# Discord guild (server) ID the approver role check and OAuth login are
# scoped to.
DISCORD_GUILD_ID=
# Discord webhook URL the executor posts remediation outcomes to.
DISCORD_WEBHOOK_URL=

# Dashboard (FastAPI read API + Discord OAuth2 approve/reject)
# OAuth2 application credentials (Discord Developer Portal -> OAuth2).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect configured on the OAuth2 application.
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Secret key used to sign the dashboard's session cookie. Generate a
# random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
DASHBOARD_SESSION_SECRET=
# Origin the dashboard frontend is served from (used for CORS and the
# post-login redirect).
DASHBOARD_ORIGIN=http://localhost:5173
# Set to "true" in any non-local deployment so the session cookie is only
# sent over HTTPS. Defaults to "false" so local HTTP dev still works.
DASHBOARD_COOKIE_SECURE=false

# Executor (only service permitted to mutate cluster state)
# Namespace the executor's k8s client is scoped to.
EXECUTOR_NAMESPACE=boutique

# Postgres
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Agent read-only tools
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TRIAGE_ALLOWED_NAMESPACES=boutique
# Port the agent exposes its Prometheus /metrics endpoint on.
METRICS_PORT=9100

# chaos bad_deploy scenario (GitOps fault injection via Gitea + Argo CD)
# Gitea: make up port-forwards svc/gitea-http to localhost:3001 (not 3000,
# which is only the in-cluster service port). Credentials are the
# chaos-admin user make up provisions (chaos-admin/chaos-admin-password),
# embedded here so `git push` from BoutiqueDeployRepo succeeds without an
# interactive prompt.
GITEA_REPO_URL=http://chaos-admin:chaos-admin-password@localhost:3001/chaos-admin/boutique-deploy.git
# Argo CD: make up port-forwards svc/argocd-server to localhost:8081 (not
# 8080, which collides with the Online Boutique frontend's own
# port-forward instructions). Argo CD serves HTTPS on that port, not
# plain HTTP.
ARGOCD_URL=https://localhost:8081
# ArgoCdClient sends this value as a literal Bearer token (Authorization:
# Bearer <token>), so it must be a real Argo CD API token/JWT, not a
# plain password. For a local kind cluster, generate one after `make up`:
#   kubectl port-forward -n gitops svc/argocd-server 8081:443 &
#   ARGOCD_PW=$(kubectl -n gitops get secret argocd-initial-admin-secret \
#     -o jsonpath='{.data.password}' | base64 -d)
#   argocd login localhost:8081 --username admin --password "$ARGOCD_PW" --insecure
#   argocd account generate-token --account admin
# Paste the generated token below.
ARGOCD_TOKEN=
